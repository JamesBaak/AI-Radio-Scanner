# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# SDR Configuration
SDR_SAMPLE_RATE=2400000
SDR_GAIN=auto

# Frequency Settings (comma-separated list of frequencies in Hz)
AM_FREQUENCIES=530000,1000000,1500000
FM_FREQUENCIES=88100000,95500000,101100000,107900000

# Detection Settings
SIGNAL_THRESHOLD=-50.0
DETECTION_DURATION=5

# Recording Settings
RECORDING_DIR=./recordings
TRANSCRIPT_DIR=./transcripts
SUMMARY_DIR=./summaries

# Monitoring Settings
SCAN_INTERVAL_SECONDS=300

# Summarization Schedule
SUMMARY_SCHEDULE_HOUR=1
